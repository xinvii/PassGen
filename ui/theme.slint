export global Palette {
    out property <color> surface: #ffffff;
    out property <color> canvas: #f3f4f7;
    out property <color> text: #182444;
    out property <color> muted: #70798b;
    out property <color> brand: #0866dc;
    out property <color> selected: #eaf2ff;
    out property <color> neutral: #f3f4f7;
    out property <color> border: #d5dae4;
    out property <color> divider: #dfe3eb;
    out property <color> error: #b42318;
}
